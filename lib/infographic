  let currentSearch=""; let currentCategory="전체"; let copyCount=0;
  const gridView=document.getElementById('grid-view'), editorView=document.getElementById('editor-view'), hero=document.getElementById('hero-section');
  function showGridView(){gridView.classList.remove('hidden');editorView.classList.add('hidden');hero.classList.remove('hidden');window.scrollTo(0,0);}
  function showEditorView(id){const t=infographicPrompts.find(p=>p.id===id);if(!t)return;gridView.classList.add('hidden');hero.classList.add('hidden');editorView.classList.remove('hidden');document.getElementById('selected-template-title').textContent=t.title;document.getElementById('prompt-textarea').value=t.prompt;window.scrollTo(0,0);}
  function renderCategories(){const cats=['전체',...new Set(infographicPrompts.map(p=>p.category))];document.getElementById('category-count').textContent=cats.length-1;document.getElementById('style-count').textContent=infographicPrompts.length;document.getElementById('category-tabs').innerHTML=cats.map(c=>`<button class="tab ${c===currentCategory?'active':''}" onclick="setCategory('${c}')">${c}</button>`).join('');}
  function renderGrid(){const q=currentSearch.toLowerCase();const filtered=infographicPrompts.filter(p=>(currentCategory==='전체'||p.category===currentCategory)&&(`${p.title} ${p.preview} ${p.category}`.toLowerCase().includes(q)));const box=document.getElementById('template-grid');if(!filtered.length){box.innerHTML='<div class="empty">검색 결과가 없습니다.</div>';return;}box.innerHTML=filtered.map(p=>`<article class="card" onclick="showEditorView(${p.id})"><div class="cardtop"><span class="category">${p.category}</span><span class="arrow">→</span></div><h3>${p.title}</h3><p>${p.preview}</p></article>`).join('');}
  function setCategory(c){currentCategory=c;renderCategories();renderGrid();}
  function handleSearch(v){currentSearch=v;renderGrid();}
  function fallbackCopy(text){const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');onCopySuccess();}catch(e){showToast('복사에 실패했습니다. 직접 선택해 복사해 주세요.')}document.body.removeChild(ta);}
  function handleCopy(){const text=document.getElementById('prompt-textarea').value;if(!text.trim())return;if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(onCopySuccess).catch(()=>fallbackCopy(text));}else fallbackCopy(text);}
  function onCopySuccess(){copyCount++;document.getElementById('copy-count').textContent=copyCount;const btn=document.getElementById('copy-btn');btn.classList.add('done');btn.textContent='복사 완료 ✓';showToast('프롬프트가 복사되었습니다.');setTimeout(()=>{btn.classList.remove('done');btn.textContent='프롬프트 복사하기';},1600);}
  function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._timer);t._timer=setTimeout(()=>t.classList.remove('show'),1900);}
  document.addEventListener('DOMContentLoaded',()=>{renderCategories();renderGrid();});
